APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://detectlab:detectlab@localhost:5432/detectlab
REDIS_URL=redis://localhost:6379/0

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=detectlab-evidence
OBJECT_STORE_ACCESS_KEY=changeme
OBJECT_STORE_SECRET_KEY=changeme

OIDC_ISSUER=http://localhost:8080/realms/detectlab
OIDC_CLIENT_ID=detectlab-web

ATTACK_CATALOG_PATH=./fixtures/attack-catalog
ATTACK_CATALOG_VERSION=vCurrent

VALIDATION_DEFAULT_TIMEOUT_SECONDS=120
VALIDATION_ALLOWED_MODES=synthetic,replay
MAX_FIXTURE_MB=10

TELEMETRY_FRESHNESS_MINUTES=60
TARGET_CAPABILITY_FRESHNESS_HOURS=24